<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated security group to bypass the singleton constraint on serial numbers -->
        <record id="group_bypass_serial_single_quant" model="res.groups">
            <field name="name">Bypass Serial Constraints</field>
            <field name="category_id" ref="base.module_category_inventory_inventory"/>
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="comment">Allows the user to enable the bypass of serial number constraints on a warehouse.</field>
        </record>
    </data>
</odoo>