<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_visibility" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.visibility</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
             <xpath expr="//div[hasclass('settings')]" position="inside">
                <h2>Replenishment</h2>
                <div class="row mt16 o_settings_container" id="replenishment_visibility">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="stock_visibility_days"/>
                            <div class="text-muted">
                                Set a global number of visibility days for replenishment forecasts.
                            </div>
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="stock_visibility_days" class="oe_inline"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>