<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_zero_cost_wizard_form" model="ir.ui.view">
        <field name="name">stock.zero.cost.wizard.form</field>
        <field name="model">stock.zero.cost.wizard</field>
        <field name="arch" type="xml">
            <form string="Zero Cost Valuation Warning">
                <field name="message" nolabel="1" readonly="1" widget="text" class="text-warning text-center font-weight-bold"/>
                <group>
                    <field name="picking_id" readonly="1"/>
                     <field name="production_id" readonly="1"/>
                     <field name="inventory_id" readonly="1"/>
                </group>
                <footer>
                    <button string="Validate (Force 0 Cost)" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>