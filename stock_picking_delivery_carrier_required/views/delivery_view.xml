<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- inherit view_picking_withcarrier_out_form on stock then add modfiers on attrs 
        to make carrier_id required field if delivery carrier if picking is delivery type

    -->
    <record id="view_picking_withcarrier_out_form" model="ir.ui.view">
        <field name="name">stock.picking.withcarrier.out.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="delivery.view_picking_withcarrier_out_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="attributes">
                <attribute name="attrs">{
                    'required': [('picking_type_code', '=', 'outgoing')],
                    'readonly': [('state', 'in', ('done', 'cancel'))]
                    }</attribute>
            </xpath>
            <xpath expr="//field[@name='carrier_tracking_ref']" position="attributes">
                <attribute name="attrs">{
                    'required': [('picking_type_code', '=', 'outgoing')],
                    'readonly': [('state', 'in', ('done', 'cancel'))]
                    }</attribute>
            </xpath>
        </field>
    </record>

    
</odoo>
