<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_warehouse_orderpoint_tree_secondary_unit" model="ir.ui.view">
            <field name="name">stock.warehouse.orderpoint.tree.secondary.unit</field>
            <field name="model">stock.warehouse.orderpoint</field>
            <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
            <field name="arch" type="xml">
                <field name="company_id" position="before">
                    <field name="secondary_uom_qty_on_hand" />
                    <field name="secondary_uom_qty_forecast" />
                    <field name="secondary_uom_qty" />
                    <field name="secondary_uom_id" />
                </field>
            </field>
        </record>

        <record id="stock_reorder_report_search_inherit" model="ir.ui.view">
            <field name="name">stock.warehouse.orderpoint.reorder.search.secondary.unit</field>
            <field name="model">stock.warehouse.orderpoint</field>
            <field name="inherit_id" ref="stock.stock_reorder_report_search"/>
            <field name="arch" type="xml">
                <filter name="groupby_category" position="after">
                    <filter string="Unity of measure" name="groupby_secondary_uom_id" domain="[]" context="{'group_by': 'secondary_uom_id'}"/>
                </filter>
            </field>
        </record>

</odoo>
